      </column>
      <column caption='Churn Rate' datatype='real' datatype-customized='true' name='[Calculation_705517062671187979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_705517062668992520] / [Calculation_705517062670159881])' />
      </column>
      <column caption='Number of Non-churned Customers' datatype='integer' name='[Calculation_90564607939624960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([CustomerId]) - SUM(IF [Exited] == 1 THEN 1 ELSE 0 END)' />
