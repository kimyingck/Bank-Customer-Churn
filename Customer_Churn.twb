      </column>
      <column caption='Active Member' datatype='string' name='[Calculation_219480146979028998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IsActiveMember] = 1 THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
      </column>
      <column caption='Complaint' datatype='string' datatype-customized='true' name='[Calculation_219480146979287047]' role='dimension' type='nominal'>
