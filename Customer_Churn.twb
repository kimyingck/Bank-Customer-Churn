      <column caption='Number of Churned Customers' datatype='integer' name='[Calculation_705517062668992520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Exited])' />
      </column>
      <column caption='Number of Customers' datatype='integer' name='[Calculation_705517062670159881]' role='measure' type='quantitative'>
